# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Database ---
# Inside Docker the host is the compose service name `db`; from your machine use localhost.
POSTGRES_USER=tafi
POSTGRES_PASSWORD=tafi
POSTGRES_DB=tafi
DATABASE_URL=postgresql+psycopg://tafi:tafi@db:5432/tafi

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Host ports (change these if something else on your machine already uses them) ---
API_PORT=8000
WEB_PORT=5173
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- API ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
